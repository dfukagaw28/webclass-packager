{
  "name": "webclass-packager",
  "version": "0.1.0",
  "private": true,
  "description": "HTML/PDF から WebClass 教材（Textbook 型）インポート用 zip を作る単体 HTML ツール",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
